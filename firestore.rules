rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(uid) { return signed() && request.auth.uid == uid; }
    function namePath(key) { return /databases/$(database)/documents/nicknames/$(key); }
    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function validName(name) {
      return name is string && name.matches('^[A-Za-z0-9_]{3,16}$');
    }

    // Private player save, available only to its owner.
    match /saves/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.keys().hasAll(['state', 'updatedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 350000
        && request.resource.data.updatedAt == request.time;
    }

    // Globally exclusive names. A nickname document is keyed by LOWERCASE nick.
    // Creation is paired atomically with profile creation/update via getAfter().
    // No user may steal, mutate, or delete another person's claim.
    match /nicknames/{key} {
      allow get: if signed(); // existence check / lookup; never contains email
      allow list: if false;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','nick','nickKey'])
        && request.resource.data.keys().hasAll(['uid','nick','nickKey'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickKey == key
        && validName(request.resource.data.nick)
        && request.resource.data.nick.lower() == key
        && getAfter(profilePath(request.auth.uid)).data.nickKey == key
        && getAfter(profilePath(request.auth.uid)).data.nick == request.resource.data.nick;
      allow update: if signed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','nick','nickKey'])
        && request.resource.data.keys().hasAll(['uid','nick','nickKey'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.nickKey == key
        && validName(request.resource.data.nick)
        && request.resource.data.nick.lower() == key
        && getAfter(profilePath(request.auth.uid)).data.nickKey == key
        && getAfter(profilePath(request.auth.uid)).data.nick == request.resource.data.nick;
      allow delete: if signed()
        && resource.data.uid == request.auth.uid
        && resource.data.nickKey == key
        && exists(profilePath(request.auth.uid))
        && getAfter(profilePath(request.auth.uid)).data.nickKey != key;
    }

    // Public profile (no email and no passwords). Nick must always have a
    // matching owned claim; old claim must be released when nick changes.
    // Scores are client-provided and NOT cheat-resistant.
    match /profiles/{uid} {
      allow get: if signed();
      allow list: if signed() && request.query.limit <= 20;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid','nick','nickKey','wins','level','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','nick','nickKey','wins','level','updatedAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.nick)
        && request.resource.data.nickKey == request.resource.data.nick.lower()
        && getAfter(namePath(request.resource.data.nickKey)).data.uid == uid
        && getAfter(namePath(request.resource.data.nickKey)).data.nick == request.resource.data.nick
        && request.resource.data.wins is int && request.resource.data.wins >= 0
        && request.resource.data.level is int && request.resource.data.level >= 1
        && request.resource.data.updatedAt == request.time
        && (!exists(profilePath(uid))
             || resource.data.nickKey == request.resource.data.nickKey
             || !existsAfter(namePath(resource.data.nickKey))
             || (exists(namePath(resource.data.nickKey))
                 && get(namePath(resource.data.nickKey)).data.uid != uid));
      allow delete: if false;
      match /friends/{friendUid} {
        allow get, list: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['uid','nick','addedAt'])
          && request.resource.data.uid == friendUid
          && request.resource.data.nick is string && request.resource.data.nick.size() <= 16
          && request.resource.data.addedAt == request.time;
        allow delete: if owner(uid);
      }
    }

    match /inbox/{recipient}/invites/{inviteId} {
      allow get, list, delete: if owner(recipient);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['from','to','fromNick','room','createdAt'])
        && request.resource.data.keys().hasAll(['from','to','fromNick','room','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to == recipient
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/friends/$(recipient))
        && request.resource.data.fromNick is string && request.resource.data.fromNick.size() <= 16
        && request.resource.data.room is string && request.resource.data.room.size() <= 150
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    match /{path=**} { allow read, write: if false; }
  }
}